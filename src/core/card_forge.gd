class_name CardForge
extends RefCounted

## The card creator's pricing model: what each choice on a card is worth, and
## the definition those choices add up to.
##
## A created card does not set its own Energy cost. Every choice has a price in
## points, the prices are added up, and the card's printed cost is what that
## total comes to — so a second point of Attack, or a second card drawn, is
## paid for rather than granted. The player sees the ledger as they build, and
## the card tells them what it is worth.
##
## Nothing here is a new mechanic. Every feature is assembled from the effect
## vocabulary in `src/core/effect_schema.gd`, the rules text is generated by
## `TextGen` like any other card's, and the result is validated by the same
## `CardDef.validate()` as the shipped catalog. A card this file cannot express
## in that vocabulary cannot be created, which is the point: the creator can
## never promise an effect the engine will not perform.

## The exchange rate between what a card does and what it costs to play.
const POINTS_PER_ENERGY := 10
## No card may cost more than this, however much is piled onto it.
const MAX_COST := 12

## A Hero is deliberately not creatable. A Hero has no play cost, so there is
## nothing for the prices to land on, and it would also have to be a unique
## named character with a place in the deck rules. Everything else is fair game.
const TYPES := ["companion", "skill", "equipment", "taahma", "location"]

## What a card is worth before anything is put on it. A Skill is nothing but
## what it does; a body that stays on the board is worth something by standing
## there.
const TYPE_BASE := {
    "companion": 6, "skill": 0, "equipment": 4, "taahma": 3, "location": 6,
}

const STAT_PRICE := {
    "attack": 3,
    "defense": 2,
    ## A Companion that raises your maximum Energy pays for every point of it.
    "energy_contribution": 5,
    ## An Equipment's printed modifiers buff a body that is already on the
    ## board, so they cost more than the same numbers on the body itself.
    "equip_attack": 4,
    "equip_defense": 3,
}

## An attack that costs nothing to declare is worth paying for; one that costs
## two Energy is a discount.
const ATTACK_COST_PRICE := {0: 5, 1: 0, 2: -3}

## A card carrying two Affinities counts for both chains.
const SECOND_AFFINITY_PRICE := 3
## Being playable on your opponent's turn.
const REACTION_PRICE := 4

## Rarity is not chosen either: it follows the total, so a card's mark says
## how much was put into it. Highest threshold first.
const RARITY_STEPS := [
    ["legendary", 55], ["rare", 38], ["uncommon", 20], ["common", 0],
]

